# Repo-level ignores. Each project keeps its own rules:
# app/.gitignore (Flutter) and django-mail-api/.gitignore (Django/Python).

# OS and editor leftovers
.DS_Store
Thumbs.db
*.swp
*.log

# Local settings, never committed
.env
.env.local

# Build output left at the root before the app moved into app/. The live copies
# are app/build, app/.dart_tool and app/.flutter-plugins-dependencies now; these
# two lines only keep the old directories out of `git status`.
build/
.dart_tool/
.flutter-plugins-dependencies
