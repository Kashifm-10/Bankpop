# Settings for the mail service. Copy this to .env (Windows: copy .env.example .env).
#
# The mail *account* is not in this file. Host, port, username, password,
# provider and the From: address live in the app's Supabase `email_settings`
# row, so the mailbox and its password can be changed without a redeploy (see
# supabase/mail_provider.sql). The EMAIL_* variables at the bottom are only the
# fallback for a machine with no Supabase - local development and test runs,
# where MAIL_PROVIDER=console prints mail instead of sending it.

# --- Supabase: where the mail account is read from ---------------------------

# Project settings > API. The service-role key stays on this server: it is what
# lets the row hold a mailbox password without the app's publishable key being
# able to read it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The table the row lives in.
MAIL_CONFIG_TABLE=email_settings
# How long a row that was read once is reused before Supabase is asked again,
# so a rotated app password takes effect within this many seconds.
MAIL_CONFIG_CACHE_SECONDS=60
MAIL_CONFIG_TIMEOUT_SECONDS=10

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# 10.0.2.2 is how the Android emulator reaches your computer.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,.wasmer.app

# --- Mail API ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The Flutter app sends this as "Authorization: Bearer <token>".
MAIL_API_TOKEN=change-me-to-a-long-random-string
# Used when the Supabase row has no from_email to derive one from.
DEFAULT_FROM_EMAIL=My App <noreply@yourdomain.com>
# Comma-separated; empty allows any recipient domain.
MAIL_ALLOWED_RECIPIENT_DOMAINS=
MAIL_MAX_RECIPIENTS=5
MAIL_RATE_LIMIT=10
MAIL_RATE_WINDOW_SECONDS=3600

# Your Flutter web app's origin(s). localhost on any port is allowed by default.
CORS_ALLOWED_ORIGINS=https://myapp.example.com

# --- Fallback account: console (default) | smtp | brevo | resend | mailgun | postmark ---
#
# Used only when SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY are unset, or Supabase
# cannot be reached, or its row is missing. `manage.py mail_config` says which
# of the two answered.
MAIL_PROVIDER=console

# SMTP (MAIL_PROVIDER=smtp). Port 465 uses SSL, anything else STARTTLS.
# Gmail: smtp.gmail.com, 587, your address, a 16-char App Password (needs 2-Step Verification)
# Zoho:  smtp.zoho.com (or smtp.zoho.in), 587, your address, app-specific password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# HTTP email API (MAIL_PROVIDER=brevo|resend|mailgun|postmark)
MAIL_API_KEY=
# Mailgun only:
MAILGUN_SENDER_DOMAIN=
# MAILGUN_API_URL=https://api.eu.mailgun.net/v3
